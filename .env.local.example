# Database URL for Prisma
# Get this from:
# 1. Vercel Dashboard → Project → Settings → Environment Variables → DATABASE_URL
# 2. Or your database provider (PostgreSQL, etc.)
# Format: postgresql://username:password@host:port/database

DATABASE_URL=postgresql://user:password@localhost:5432/vm-store

# Clerk Public Key (optional, already set in Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_key_here

# Clerk Secret Key (optional, already set in Vercel)
CLERK_SECRET_KEY=your_clerk_secret_here

# Razorpay API credentials for server-side order creation and payment verification
# Use a public key in the frontend and a secret key only on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Emails (comma-separated for multiple admins) - IMPORTANT: Keep this secret!
# Only users with these email addresses can access the admin panel
ADMIN_EMAILS=abhishek.sharma1998r@gmail.com
